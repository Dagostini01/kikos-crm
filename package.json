{
  "name": "kikos-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Kikos CRM monorepo",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @kikos/api dev",
    "dev:api": "pnpm --filter @kikos/api dev",
    "dev:web": "pnpm --filter @kikos/web dev",
    "build": "pnpm --filter @kikos/api build",
    "build:web": "pnpm --filter @kikos/web build",
    "start": "pnpm --filter @kikos/api start",
    "lint": "pnpm --filter @kikos/api lint && pnpm --filter @kikos/web lint",
    "format": "pnpm --filter @kikos/api format",
    "typecheck": "pnpm --filter @kikos/api typecheck && pnpm --filter @kikos/web typecheck",
    "test": "pnpm --filter @kikos/api test",
    "db:generate": "pnpm --filter @kikos/api db:generate",
    "db:migrate": "pnpm --filter @kikos/api db:migrate",
    "db:studio": "pnpm --filter @kikos/api db:studio"
  },
  "license": "UNLICENSED"
}
